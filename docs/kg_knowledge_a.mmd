%% 知识点图谱 A
flowchart LR
  subgraph K_OPT["优化目标与信任域"]
    c_pg["策略梯度定理"]
    c_is["重要性采样比"]
    c_tr["信任域与 KL 约束"]
    c_clip["clip 死区"]
    c_ent["熵正则与熵预算"]
    c_rkl["反向 KL 与模式覆盖"]
    c_md["镜像下降 / Bregman 散度"]
  end
  subgraph K_CREDIT["信用分配"]
    c_adv["优势函数 A=Q−V"]
    c_gae["广义优势估计 GAE"]
    c_group["组相对基线（RLOO/GRPO）"]
    c_axiom["信用分配三公理"]
    c_prm["过程奖励与不可验证性"]
    c_graph["轨迹图与图上 Bellman 反传"]
    c_bv["偏差-方差权衡"]
  end
  subgraph K_REWARD["奖励与验证"]
    c_rlvr["可验证奖励 RLVR"]
    c_shape["奖励塑形与有界饱和"]
    c_rubric["Rubric-as-Reward"]
    c_hack["奖励黑客"]
    c_agg["多奖励聚合与投影"]
    c_grm["生成式奖励模型 GRM"]
    c_settle["校准与密封结算流"]
    c_psr["严格 proper scoring rule"]
  end
  c_pg --> c_adv
  c_adv --> c_gae
  c_gae --> c_group
  c_group --> c_axiom
  c_axiom --> c_prm
  c_graph --> c_axiom
  c_bv --> c_gae
  c_bv -.->|对立| c_prm
  c_is --> c_tr
  c_tr -.->|对立| c_clip
  c_tr --> c_md
  c_ent -.->|对立| c_rkl
  c_rlvr -.->|对立| c_hack
  c_shape -.->|对立| c_hack
  c_rubric -.->|对立| c_hack
  c_agg --> c_hack
  c_grm -.->|对立| c_hack
  c_psr -.->|对立| c_hack
  c_settle --> c_hack
  c_settle --> c_psr
